# Copy to .env and fill in locally. NEVER COMMIT your real .env.
OPENAI_API_KEY=
GOOGLE_API_KEY=
DATABASE_URL=postgresql+psycopg://octodig:change-me@localhost:5432/octodig
JWT_SECRET=replace-with-a-long-random-secret
OCTODIG_CORS_ORIGINS=http://localhost:5173
OCTODIG_PUBLIC_API_URL=http://localhost:8000
# Existing examples 01-03: OpenAI only (hosted search requires OpenAI).
OCTODIG_MODEL=openai:gpt-5-nano
# Example 05: provider-agnostic baseline, no search.
OCTODIG_GPT_MODEL=openai:gpt-5-nano
OCTODIG_GEMINI_MODEL=google_genai:gemini-2.5-flash-lite

# Optional LangSmith tracing, not enabled by default:
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=OctoDig
